# Copy this file to `.env` at the repo root and fill in your values.
# Used by docker-compose.yml and by `docker compose up --build`.

# --- AI investigator (optional) -----------------------------------------
# The app runs fine without it; the AI agent/investigations degrade to
# HUMAN_REVIEW instead of failing.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0

# --- Frontend / API wiring -----------------------------------------------
# The public URL of the API as the BROWSER sees it. This value is baked into
# the frontend bundle at build time (NEXT_PUBLIC_*), so set it before
# `docker compose build` / `up --build`.
#   local dev:   http://localhost:8000
#   a server:    https://api.yourdomain.com  (or http://<server-ip>:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated list of browser origins allowed to call the API.
#   local dev:   http://localhost:3000
#   a server:    https://yourdomain.com
CORS_ORIGINS=http://localhost:3000